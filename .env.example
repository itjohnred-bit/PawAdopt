# ============================================================================
# PawAdopt — Environment Variables (placeholders only — NEVER real secrets)
#
# How configuration is loaded (in priority order):
#   1. Real environment variables (Render dashboard → Environment, or Docker
#      `-e` flags) — these always win.
#   2. A local `.env` file in the project root, read by config/env.php
#      (copy this file to `.env` and fill in real values locally;
#      `.env` is excluded from the Docker image by .dockerignore).
#
# Sensitive = values that must never be committed or exposed to the browser.
# ============================================================================

# ── Database (REQUIRED) ────────────────────────────────────────────────────
# Purpose : MySQL/MariaDB connection used by config/database.php (PDO).
# Required: YES — the app refuses to start without DB_HOST and DB_USER.
# Where   : Render dashboard → pawadopt-web → Environment (production),
#           or .env locally.
DB_HOST=your-mysql-host.example.com        # e.g. xxx.aivencloud.com — SENSITIVE (infra)
DB_PORT=3306                               # default 3306
DB_NAME=pawadopt                           # database name (defaultdb on Aiven)
DB_USER=your_mysql_runtime_user            # least-privilege user — SENSITIVE
DB_PASS=your_mysql_password                # SECRET — SENSITIVE

# ── Application ────────────────────────────────────────────────────────────
# APP_URL    : public base URL, no trailing slash. OPTIONAL on Render
#              (auto-derived from the request host / RENDER_EXTERNAL_URL).
#              Set it explicitly when behind a custom domain or proxy.
# APP_ENV    : "production" (default) — keep development values off Render.
# UPLOAD_PATH: absolute writable uploads dir. Default: <project>/uploads.
#              On Render paid plans with a disk mounted at
#              /var/www/html/uploads, no change is needed; on the FREE plan
#              uploads are ephemeral (see DEPLOY.md).
APP_URL=https://your-service.onrender.com
APP_ENV=production
UPLOAD_PATH=/var/www/html/uploads

# ── AI assistant (server-side only) ────────────────────────────────────────
# Purpose : powers the PawBot assistant (login.php calls the Gemini REST API
#           from the server via cURL). Never sent to the browser.
# Required: for the chat feature (app works without it; endpoint returns 500).
GEMINI_API_KEY=your_gemini_api_key_here    # SECRET — SENSITIVE

# ── SMTP mail (server-side only) ───────────────────────────────────────────
# Purpose : password-reset OTP e-mails, sent by api/auth.php over SMTP.
# Required: for password reset (app works without it; e-mail features fail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_sender@example.com
SMTP_PASSWORD=your_email_app_password      # SECRET — SENSITIVE
SMTP_FROM_EMAIL=your_sender@example.com
SMTP_FROM_NAME=PawAdopt
